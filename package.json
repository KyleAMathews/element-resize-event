{
  "name": "element-resize-event",
  "description": "Polyfill to make it easy to listen for element resize events",
  "version": "3.0.6",
  "author": "Kyle Mathews <mathews.kyle@gmail.com>",
  "bugs": {
    "url": "https://github.com/KyleAMathews/element-resize-event/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/KyleAMathews/element-resize-event",
  "keywords": [
    "element queries",
    "element-query",
    "event",
    "resize"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleAMathews/element-resize-event.git"
  },
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:example": "esbuild example/index.ts --bundle --outfile=example/bundle.js",
    "check:es5": "es-check es5 dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm build && tsc -p test/tsconfig.json"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": "eslint --cache --fix",
    "*.{js,mjs,ts,json,md,yml,yaml,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^5.1.0",
    "es-check": "^9.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}

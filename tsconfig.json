{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es5", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
